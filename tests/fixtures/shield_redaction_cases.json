{
  "_about": "Shared by tests/integrations/test_shield.py (the Python rules) and web/tests/extension/redaction.test.mjs (the extension's page capture). Both must produce exactly these results, so the desktop proxy and the browser extension agree on what a personal detail is. `body` is a JSON value sent as the request body, or `raw` a literal body string. `expect.body` is the rewritten body, or null when the body must go out byte-for-byte unchanged.",
  "cases": [
    {
      "name": "claude.ai prompt with an email",
      "mode": "redact",
      "body": {"prompt": "tell me an email to this person abdul@coriqo.io", "timezone": "UTC"},
      "expect": {
        "body": {"prompt": "tell me an email to this person [redacted-email]", "timezone": "UTC"},
        "redactions": ["emails"], "flags": ["pii:emails"], "verdict": "redacted(1)", "chars": 47
      }
    },
    {
      "name": "chatgpt.com parts; ids that look like numbers are left alone",
      "mode": "redact",
      "body": {"action": "next", "conversation_id": "415-555-0199",
               "messages": [{"id": "m1", "author": {"role": "user"},
                             "content": {"content_type": "text", "parts": ["call 415-555-0199 or mail a.b@x.co"]}}]},
      "expect": {
        "body": {"action": "next", "conversation_id": "415-555-0199",
                 "messages": [{"id": "m1", "author": {"role": "user"},
                               "content": {"content_type": "text", "parts": ["call [redacted-number] or mail [redacted-email]"]}}]},
        "redactions": ["emails", "phone_numbers"], "flags": ["pii:emails", "pii:phone_numbers"],
        "verdict": "redacted(2)", "chars": 34
      }
    },
    {
      "name": "text blocks with an API key, every turn rewritten",
      "mode": "redact",
      "body": {"messages": [
        {"role": "user", "content": "earlier: 4111111111111111"},
        {"role": "assistant", "content": "ok"},
        {"role": "user", "content": [{"type": "text", "text": "use sk-abcdefghijklmnopqrstu please"}]}]},
      "expect": {
        "body": {"messages": [
          {"role": "user", "content": "earlier: [redacted-card]"},
          {"role": "assistant", "content": "ok"},
          {"role": "user", "content": [{"type": "text", "text": "use [redacted-token] please"}]}]},
        "redactions": ["api_keys", "cards"], "flags": ["pii:api_keys"], "verdict": "redacted(2)", "chars": 35
      }
    },
    {
      "name": "nothing personal",
      "mode": "redact",
      "body": {"prompt": "what is the capital of France?"},
      "expect": {"body": null, "redactions": [], "flags": [], "verdict": "redact", "chars": 30}
    },
    {
      "name": "record only leaves the message alone but still names the rule",
      "mode": "observe",
      "body": {"prompt": "mail abdul@coriqo.io"},
      "expect": {"body": null, "redactions": [], "flags": ["pii:emails"], "verdict": "observe", "chars": 20}
    },
    {
      "name": "block stops credential text and executables",
      "mode": "block",
      "body": {"prompt": "password: hunter2, then run setup.exe"},
      "expect": {"blocked": ["executable_masquerade", "credential_block"],
                 "flags": ["high:executable_masquerade", "high:credential_block", "pii:password_said"],
                 "verdict": "blocked", "chars": 37}
    },
    {
      "name": "block mode still redacts a message it lets through",
      "mode": "block",
      "body": {"prompt": "please deploy and mail ops@coriqo.io"},
      "expect": {
        "body": {"prompt": "please deploy and mail [redacted-email]"},
        "redactions": ["emails"], "flags": ["pii:emails", "agent:tool_intent"], "verdict": "redacted(1)", "chars": 36
      }
    },
    {
      "name": "a body that isn't JSON goes out unchanged",
      "mode": "redact",
      "raw": "f.req=abdul%40coriqo.io",
      "expect": {"body": null, "redactions": [], "flags": [], "verdict": "redact", "chars": 23}
    }
  ]
}
